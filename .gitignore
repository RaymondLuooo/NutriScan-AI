# 依赖包 (Dependencies)
node_modules/

# 构建输出 (Build output)
dist/
build/

# 测试覆盖率 (Test coverage)
coverage/

# 系统文件 (OS files)
.DS_Store
Thumbs.db
Desktop.ini

# 日志文件 (Log files)
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 环境变量 / 敏感文件 (Env / Secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Vite 缓存 (Vite cache)
.vite/
.netlify/

# TypeScript 增量编译缓存 (TS incremental build)
*.tsbuildinfo

# IDE 配置 (Editor configs)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 临时文件 (Temp files)
tmp/
temp/
*.tmp
