# GEMINI_API_KEY: Required by the server-side /api/analyze endpoint.
# Do not expose this value to browser code or VITE_* variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_BASE_URL: Optional. Set when deploying under a subpath.
# Example for GitHub Pages repository pages: /nutriscan-ai/
VITE_BASE_URL="/"
